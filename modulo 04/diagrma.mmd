    PACIENTE {
        int id_paciente PK
        varchar nome_completo
        varchar cpf
        varchar rg
        date data_nascimento
        varchar sexo
        varchar telefone
        varchar email
        varchar endereco
        varchar cidade
        varchar estado
        varchar cep
        varchar contato_emergencia
        varchar telefone_emergencia
        varchar profissao
        decimal altura
        decimal peso_inicial
        text objetivo_principal
        text restricoes_fisicas
        text restricoes_alimentares
        text doencas_preexistentes
        text alergias
        text medicamentos_uso
        date data_cadastro
        varchar status_paciente
    }

    EDUCADOR_FISICO {
        int id_educador_fisico PK
        varchar nome_completo
        varchar cpf
        varchar cref
        varchar especialidade
        varchar telefone
        varchar email
        varchar endereco_profissional
        date data_contratacao
        varchar disponibilidade_atendimento
        varchar status_profissional
    }

    NUTRICIONISTA {
        int id_nutricionista PK
        varchar nome_completo
        varchar cpf
        varchar crn
        varchar especialidade
        varchar telefone
        varchar email
        varchar endereco_profissional
        date data_contratacao
        varchar disponibilidade_atendimento
        varchar status_profissional
    }

    CONSULTA_FISICA {
        int id_consulta_fisica PK
        int id_paciente FK "referencia"
        int id_educador_fisico FK "referencia"
        date data_consulta
        time horario
        varchar tipo_consulta
        text objetivo_paciente
        text avaliacao_fisica
        decimal frequencia_cardiaca
        varchar pressao_arterial
        decimal percentual_gordura
        decimal imc
        varchar condicionamento_fisico
        text observacoes_gerais
        text recomendacoes
        date proxima_consulta
    }

    PLANO_TREINO {
        int id_plano_treino PK
        int id_paciente FK "referencia"
        int id_educador_fisico FK "referencia"
        date data_inicio
        date data_termino
        text objetivo_treino
        varchar nivel_dificuldade
        int frequencia_semanal
        decimal duracao_media_treino
        text observacoes_gerais
        varchar status_plano
    }

    EXERCICIO_TREINO {
        int nr_exercicio PK
        int id_plano_treino PK, FK "compoe a chave primaria (entidade fraca)"
        varchar nome_exercicio
        varchar grupo_muscular
        int series
        int repeticoes
        decimal carga
        varchar tempo_execucao
        varchar intervalo
        varchar modalidade
        text observacoes_tecnicas
    }

    EVOLUCAO_FISICA {
        int id_evolucao_fisica PK
        int id_paciente FK "referencia"
        int id_educador_fisico FK "referencia"
        date data_avaliacao
