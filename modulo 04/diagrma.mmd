    PAGAMENTO {
        int id_pagamento PK
        int id_paciente FK "referencia"
        int id_adesao FK "referencia (opcional)"
        varchar tipo_cobranca
        varchar descricao
        decimal valor
        date data_vencimento
        date data_pagamento
        varchar forma_pagamento
        varchar situacao_pagamento
        decimal desconto
        decimal multa
        text observacoes_financeiras
    }

    PLANO_ACOMPANHAMENTO {
        int id_plano_acompanhamento PK
        varchar nome_plano
        text descricao
        decimal valor_mensal
        varchar periodicidade
        text servicos_inclusos
        date data_inicio_vigencia
        date data_termino_vigencia
        varchar situacao_plano
    }

    ADESAO_PLANO {
        int id_adesao PK
        int id_paciente FK "referencia"
        int id_plano_acompanhamento FK "referencia"
        date data_adesao
        varchar status_contratacao
        text observacoes_contratuais
    }

    PACIENTE ||--o{ CONSULTA_FISICA : "realiza"
    EDUCADOR_FISICO ||--o{ CONSULTA_FISICA : "atende"
