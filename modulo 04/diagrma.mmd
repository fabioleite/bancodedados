        decimal percentual_gordura
        decimal massa_muscular
        decimal imc
        decimal circunferencia_abdominal
        decimal circunferencia_toracica
        text medidas_corporais
        text desempenho_fisico
        text observacoes
        text metas_alcancadas
    }

    CONSULTA_NUTRICIONAL {
        int id_consulta_nutricional PK
        int id_paciente FK "referencia"
        int id_nutricionista FK "referencia"
        date data_consulta
        time horario
        text objetivo_nutricional
        text habitos_alimentares
        decimal consumo_agua
        text restricoes_alimentares
        text alergias
        text intolerancias
        text suplementacao
        text observacoes_clinicas
        text recomendacoes
        date proxima_consulta
    }

    PLANO_ALIMENTAR {
        int id_plano_alimentar PK
        int id_paciente FK "referencia"
        int id_nutricionista FK "referencia"
        date data_inicio
        date data_termino
        text objetivo_nutricional
        decimal calorias_diarias
        decimal proteinas
        decimal carboidratos
        decimal gorduras
        text observacoes_gerais
        varchar status_plano
    }

    ITEM_PLANO_ALIMENTAR {
        int nr_item PK
        int id_plano_alimentar PK, FK "compoe a chave primaria (entidade fraca)"
        varchar refeicao
        time horario
        varchar alimento
        decimal quantidade
        varchar unidade_medida
        text substituicoes_permitidas
        text observacoes
    }

    EVOLUCAO_NUTRICIONAL {
        int id_evolucao_nutricional PK
        int id_paciente FK "referencia"
        int id_nutricionista FK "referencia"
        date data_avaliacao
        decimal peso
